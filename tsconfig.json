{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    // TypeScript 6.0 n'acquiert plus d'office les globales de @types/node
    // (process, node:fs…) — src/version.test.ts et src/theme.test.ts en
    // dépendent. Sans cette ligne : « Cannot find name 'process' » / modules
    // node:* introuvables, même piège que côté app (docs/migrations… TS 6.0).
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "noEmit": true
  },
  "include": ["src"]
}
